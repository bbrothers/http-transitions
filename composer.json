{
    "name" : "bbrothers/http-transitions",
    "description" : "API versioning with transition stages (migrations) based on a request header.",
    "keywords" : [
        "api",
        "http",
        "versioning",
        "transition",
        "schema",
        "middleware",
        "migrations"
    ],
    "homepage" : "https://github.com/bbrothers/http-transitions",
    "license" : "MIT",
    "require" : {
        "php" : "^8.3",
        "ext-json": "*",
        "illuminate/config" : "^12.0|^13.0",
        "illuminate/console" : "^12.0|^13.0",
        "illuminate/contracts" : "^12.0|^13.0",
        "illuminate/http" : "^12.0|^13.0",
        "illuminate/support" : "^12.0|^13.0"
    },
    "require-dev" : {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload" : {
        "psr-4" : {
            "Transitions\\" : "src"
        }
    },
    "autoload-dev" : {
        "psr-4" : {
            "Transitions\\" : "tests"
        }
    },
    "scripts" : {
        "test" : "vendor/bin/phpunit",
        "format" : "vendor/bin/pint",
        "analyse" : "vendor/bin/phpstan analyse"
    },
    "config" : {
        "sort-packages" : true
    },
    "extra" : {
        "laravel" : {
            "providers" : [
                "Transitions\\TransitionProvider"
            ]
        }
    }
}
